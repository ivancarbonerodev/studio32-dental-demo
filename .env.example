# Copia este archivo a .env para desarrollo local (el build y `npm run dev` lo leen). NUNCA subas .env al repositorio.
# En Netlify, define las mismas variables en: Site configuration → Environment variables.

# URL pública del sitio (og:image, canonical, sitemap, JSON-LD). En Netlify se usa la variable URL si no la defines.
SITE_URL=https://studio32.example.com

# Cal.com: usuario/tipo-de-evento (solo el path, sin https://cal.com/). Ej: studio32/revision-digital
# En el evento activa el campo Teléfono (attendeePhoneNumber) y un desplegable con identificador "tratamiento" (opciones: Revision, Ortodoncia invisible, Blanqueamiento, Implantes, Urgencia).
CAL_LINK=tu-usuario/revision-digital

# WhatsApp: número internacional sin + ni espacios. Ej: 34600123456
WHATSAPP_NUMBER=34600000000

# Plausible: dominio tal y como está dado de alta en plausible.io. Vacío = analítica desactivada.
PLAUSIBLE_DOMAIN=

# Asistente de IA (Netlify Function /api/chat). SECRETO: solo servidor, nunca en el cliente.
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# Leads (Netlify Function /lead). Orden de entrega: 1) LEAD_WEBHOOK_URL, 2) correo con Resend, 3) solo logs (modo demo).
# Opcional: si se define, cada lead se reenvía como JSON a esta URL (POST) y NO se envía correo.
LEAD_WEBHOOK_URL=

# Aviso por correo de cada lead con Resend (https://resend.com → API Keys). SECRETO: solo servidor.
# Se usa solo si NO hay LEAD_WEBHOOK_URL. Hay que definir las dos variables.
# El remitente es onboarding@resend.dev, que solo puede enviar al correo con el que te registraste en Resend.
RESEND_API_KEY=
# Tu correo (el de la cuenta de Resend). Admite varios separados por comas si verificas un dominio en Resend.
LEAD_NOTIFY_EMAIL=
